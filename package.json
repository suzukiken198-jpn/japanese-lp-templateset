{
  "name": "japanese-lp-templateset",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "dev:site": "npm run build:site && node scripts/serve-site.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "validate": "node scripts/validate.mjs",
    "setup": "node scripts/run-templates.mjs install",
    "build:all": "node scripts/run-templates.mjs build",
    "package:all": "npm run validate && npm run build:all && node scripts/package-all.mjs"
  }
}
